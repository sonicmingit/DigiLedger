<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.digiledger.backend.mapper.WishlistPriceHistoryMapper">
    <resultMap id="historyMap" type="com.digiledger.backend.model.entity.WishlistPriceHistory">
        <id column="id" property="id"/><result column="wishlist_id" property="wishlistId"/>
        <result column="price" property="price"/><result column="captured_at" property="capturedAt"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>
    <select id="findByWishlistId" resultMap="historyMap">
        SELECT * FROM wishlist_price_history WHERE wishlist_id = #{wishlistId}
        ORDER BY captured_at DESC, id DESC
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO wishlist_price_history (wishlist_id, price, captured_at)
        VALUES (#{wishlistId}, #{price}, #{capturedAt})
    </insert>
</mapper>
