<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.digiledger.backend.mapper.EquipUpgradeRouteMapper">

    <resultMap id="routeResultMap" type="com.digiledger.backend.model.entity.EquipUpgradeRoute">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="root_asset_id" property="rootAssetId" />
        <result column="remark" property="remark" />
        <result column="is_deleted" property="isDeleted" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <select id="findAll" resultMap="routeResultMap">
        SELECT *
        FROM equip_upgrade_route
        WHERE is_deleted = 0
        ORDER BY updated_at DESC, id DESC
    </select>

    <select id="findById" parameterType="long" resultMap="routeResultMap">
        SELECT *
        FROM equip_upgrade_route
        WHERE id = #{id} AND is_deleted = 0
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.digiledger.backend.model.entity.EquipUpgradeRoute" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO equip_upgrade_route (name, root_asset_id, remark)
        VALUES (#{name}, #{rootAssetId}, #{remark})
    </insert>

    <update id="update" parameterType="com.digiledger.backend.model.entity.EquipUpgradeRoute">
        UPDATE equip_upgrade_route
        SET name = #{name},
            root_asset_id = #{rootAssetId},
            remark = #{remark},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id} AND is_deleted = 0
    </update>

    <update id="softDelete" parameterType="long">
        UPDATE equip_upgrade_route
        SET is_deleted = 1,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>
</mapper>
