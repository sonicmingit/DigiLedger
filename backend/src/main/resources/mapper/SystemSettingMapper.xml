<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.digiledger.backend.mapper.SystemSettingMapper">

    <resultMap id="settingResultMap" type="com.digiledger.backend.model.entity.SystemSetting">
        <id column="id" property="id" />
        <result column="currency" property="currency" />
        <result column="storage_provider" property="storageProvider" />
        <result column="storage_endpoint" property="storageEndpoint" />
        <result column="storage_region" property="storageRegion" />
        <result column="storage_bucket" property="storageBucket" />
        <result column="storage_access_key" property="storageAccessKey" />
        <result column="storage_secret_key" property="storageSecretKey" />
        <result column="storage_base_url" property="storageBaseUrl" />
        <result column="default_cover_provider" property="defaultCoverProvider" />
        <result column="image_search_provider_codes" property="imageSearchProviderCodes" />
        <result column="date_format" property="dateFormat" />
        <result column="auto_backup_enabled" property="autoBackupEnabled" />
        <result column="auto_backup_time" property="autoBackupTime" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <select id="findLatest" resultMap="settingResultMap">
        SELECT * FROM sys_setting ORDER BY updated_at DESC LIMIT 1
    </select>

    <insert id="insertDefaultProvider">
        INSERT INTO sys_setting (default_cover_provider)
        VALUES (#{provider})
    </insert>

    <update id="updateDefaultProvider">
        UPDATE sys_setting
        SET default_cover_provider = #{provider}
        WHERE id = #{id}
    </update>

    <insert id="insertImageSearchProviders">
        INSERT INTO sys_setting (image_search_provider_codes)
        VALUES (CAST(#{providers} AS JSON))
    </insert>

    <update id="updateImageSearchProviders">
        UPDATE sys_setting
        SET image_search_provider_codes = CAST(#{providers} AS JSON)
        WHERE id = #{id}
    </update>

    <insert id="insertPreferences">
        INSERT INTO sys_setting (currency, date_format, auto_backup_enabled, auto_backup_time)
        VALUES (#{currency}, #{dateFormat}, #{autoBackupEnabled}, #{autoBackupTime})
    </insert>

    <update id="updatePreferences">
        UPDATE sys_setting SET currency = #{currency}, date_format = #{dateFormat},
            auto_backup_enabled = #{autoBackupEnabled}, auto_backup_time = #{autoBackupTime},
            updated_at = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>

</mapper>
