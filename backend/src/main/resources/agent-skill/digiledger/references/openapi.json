{
  "openapi": "3.0.3",
  "info": {
    "title": "DigiLedger 对外 Agent API",
    "version": "1.0.0",
    "description": "对外接口默认关闭。PC 系统设置生成 Token 并选择只读或读写权限。Token 仅保护 /api/open/**；内部管理页面与接口需保留在可信网络或已有网关认证之后。请求/响应字段为 camelCase，筛选参数为 snake_case。写请求无幂等保证，不应盲目自动重试。"
  },
  "servers": [
    {
      "url": "/api/open/v1",
      "description": "当前实例"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/assets": {
      "get": {
        "operationId": "listAssets",
        "summary": "分页查询物品",
        "responses": {
          "200": {
            "description": "统一响应。HTTP 200 仍须检查 code，错误时 data 可能省略。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    }
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AssetPage"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bearer Token 缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "开放 API 已关闭，或 Token 无写入权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "keyword",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "使用中",
                "已闲置",
                "待出售",
                "已出售",
                "已丢弃"
              ]
            }
          },
          {
            "in": "query",
            "name": "category_id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "in": "query",
            "name": "brand_id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "in": "query",
            "name": "platform_id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "in": "query",
            "name": "tag_ids",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            },
            "style": "form",
            "explode": false
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      },
      "post": {
        "operationId": "createAsset",
        "summary": "新增物品，需要读写权限",
        "responses": {
          "200": {
            "description": "统一响应。HTTP 200 仍须检查 code，错误时 data 可能省略。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    }
                  ],
                  "properties": {
                    "data": {
                      "type": "integer",
                      "format": "int64"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bearer Token 缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "开放 API 已关闭，或 Token 无写入权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetCreate"
              }
            }
          }
        }
      }
    },
    "/assets/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "getAsset",
        "summary": "查询完整物品详情",
        "responses": {
          "200": {
            "description": "统一响应。HTTP 200 仍须检查 code，错误时 data 可能省略。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    }
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AssetDetail"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bearer Token 缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "开放 API 已关闭，或 Token 无写入权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchAsset",
        "summary": "局部编辑物品，需要读写权限",
        "responses": {
          "200": {
            "description": "统一响应。HTTP 200 仍须检查 code，错误时 data 可能省略。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Bearer Token 缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "开放 API 已关闭，或 Token 无写入权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetPatch"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteAsset",
        "summary": "删除物品，需要读写权限；关联记录可能阻止删除",
        "responses": {
          "200": {
            "description": "统一响应。HTTP 200 仍须检查 code，错误时 data 可能省略。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Bearer Token 缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "开放 API 已关闭，或 Token 无写入权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/dict/categories/tree": {
      "get": {
        "operationId": "getCategories",
        "summary": "查询分类树",
        "responses": {
          "200": {
            "description": "统一响应。HTTP 200 仍须检查 code，错误时 data 可能省略。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
