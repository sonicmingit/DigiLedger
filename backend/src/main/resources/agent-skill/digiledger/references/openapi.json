                    }
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CategoryNode"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bearer Token 缺失或无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "开放 API 已关闭，或 Token 无写入权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/dict/brands": {
      "get": {
        "operationId": "getBrands",
        "summary": "查询品牌列表",
        "responses": {
          "200": {
            "description": "统一响应。HTTP 200 仍须检查 code，错误时 data 可能省略。",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Envelope"
                    }
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Brand"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bearer Token 缺失或无效",
            "content": {
              "application/json": {
                "schema": {
