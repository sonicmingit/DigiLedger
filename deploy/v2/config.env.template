# Copy created automatically as config.env on the first deployment.
# Change every password before exposing this stack to an untrusted network.
COMPOSE_PROJECT_NAME=digiledger-v2
APP_PORT=5200
MYSQL_PORT=3307
MINIO_CONSOLE_PORT=9002

MYSQL_DATABASE=digiledger
MYSQL_ROOT_PASSWORD=change-this-mysql-password
MINIO_ROOT_USER=change-this-minio-user
MINIO_ROOT_PASSWORD=change-this-minio-password

# Must be reachable by the browser. Update the host name for a remote server.
DL_STORAGE_BASE_URL=http://localhost:5200/oss
DL_BING_IMAGE_API_KEY=
