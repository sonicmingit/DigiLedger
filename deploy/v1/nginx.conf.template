# A trusted outer HTTPS proxy must overwrite X-Forwarded-Proto.
map $http_x_forwarded_proto $dl_forwarded_proto {
    default $scheme;
    http http;
    https https;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # A 5 MiB file needs a little extra room for multipart form data.
        client_max_body_size 6m;
        proxy_pass http://backend:${DL_SERVER_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $dl_forwarded_proto;
    }

    # Images and attachments are served through the backend, which can reach
    # the private MinIO endpoint from the internal network.
    location /oss/ {
        proxy_pass http://backend:${DL_SERVER_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $dl_forwarded_proto;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
