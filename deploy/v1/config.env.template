# Copy created automatically as config.env on the first deployment.
# Configure the externally managed database and object storage before deployment.
COMPOSE_PROJECT_NAME=digiledger-v1
APP_PORT=5100
BACKEND_PORT=5101
DL_SERVER_PORT=8080
DL_FLYWAY_ENABLED=true

DL_DB_HOST=database.example.com
DL_DB_PORT=3306
DL_DB_NAME=digiledger
DL_DB_USER=digiledger
DL_DB_PASS=change-this-database-password

DL_STORAGE_PROVIDER=minio
DL_STORAGE_ENDPOINT=https://storage.example.com
DL_STORAGE_REGION=
DL_STORAGE_BUCKET=digiledger
DL_STORAGE_ACCESS_KEY=change-this-storage-access-key
DL_STORAGE_SECRET_KEY=change-this-storage-secret-key
# Optional legacy MinIO origin used to recognize historical URLs. Browser media
# URLs are now relative /oss/... paths, so no fixed public storage domain is needed.
DL_STORAGE_BASE_URL=
