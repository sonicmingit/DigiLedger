{
  "name": "digiledger-uniapp",
  "private": true,
  "version": "1.0.10",
  "scripts": {
    "dev:h5": "uni",
    "dev:app-android": "uni -p app-android",
    "build:h5": "uni build",
    "build:app-android": "uni build -p app-android",
    "sync:android": "npm run build:h5 && cap sync android",
    "build:apk": "npm run sync:android && cd android && gradlew.bat assembleDebug",
    "build:apk:version": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "verify:h5": "tsc --noEmit && node scripts/verify-mobile-alignment.mjs && npm run build:h5"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@dcloudio/uni-app": "3.0.0-alpha-3080220230511001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-3080220230511001",
    "@dcloudio/uni-components": "3.0.0-alpha-3080220230511001",
    "@dcloudio/uni-h5": "3.0.0-alpha-3080220230511001",
    "vue": "^3.2.45"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@dcloudio/types": "^3.3.2",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-3080220230511001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-3080220230511001",
    "@vue/compiler-sfc": "^3.2.45",
    "sass": "^1.62.1",
    "typescript": "^4.9.5",
    "vite": "^4.0.3"
  }
}
